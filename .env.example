# ---------------------------------------------------------------------------
# Cairn configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (docker compose `db` service is published on 127.0.0.1:5433) ---
POSTGRES_USER=cairn
POSTGRES_PASSWORD=cairn
POSTGRES_DB=cairn
POSTGRES_PORT=5433
# Used by the backend when running outside Docker (local dev / tests)
DATABASE_URL=postgresql+psycopg://cairn:cairn@127.0.0.1:5433/cairn
TEST_DATABASE_URL=postgresql+psycopg://cairn:cairn@127.0.0.1:5433/cairn_test

# --- Auth ---
# Allow new accounts to be created from the sign-up page
ALLOW_REGISTRATION=true
# Set to true when serving over HTTPS
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# --- Storage (screenshots, thumbnails, favicons) ---
STORAGE_DIR=./storage

# --- Fetching / extraction ---
# Only enable for local testing: allows fetching localhost/private IPs (disables SSRF guard)
ALLOW_PRIVATE_NETWORKS=false
RESPECT_ROBOTS_TXT=true
BROWSER_ENABLED=true
WORKER_CONCURRENCY=2
DOMAIN_DELAY_SECONDS=1.5
MAX_ATTEMPTS=3
HEALTH_CHECK_DAYS=7

# --- AI enrichment ---
# extractive | anthropic | openai | gemini | ollama | openai_compatible
#   extractive = no LLM: summaries come only from the page's own metadata/content
AI_PROVIDER=extractive
# Leave blank to use provider defaults (see ARCHITECTURE.md)
AI_MODEL_FAST=
AI_MODEL_SMART=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# For AI_PROVIDER=openai_compatible (any OpenAI-compatible server)
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Max characters of page content sent to the LLM per link (cost control).
# For Ollama use ~6000 unless the Ollama server runs with a larger context (OLLAMA_CONTEXT_LENGTH=8192+),
# otherwise long prompts are silently truncated.
AI_MAX_INPUT_CHARS=12000

# --- Embeddings (semantic search) ---
# fastembed runs locally on CPU, no API key needed. `hash` is a lexical test/offline embedder.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=./.models

# --- Optional integrations ---
# Raises the GitHub API rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
